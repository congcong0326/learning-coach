APP_ENV=local

BACKEND_PORT=8000
FRONTEND_PORT=5173

POSTGRES_DB=learning_coach
POSTGRES_USER=learning_coach
POSTGRES_PASSWORD=learning_coach
POSTGRES_HOST_PORT=15432

# 本机直接运行后端时使用 localhost；Docker Compose 中会覆盖为 postgres 服务名。
DATABASE_URL=postgresql+asyncpg://learning_coach:learning_coach@localhost:15432/learning_coach
DOCKER_DATABASE_URL=postgresql+asyncpg://learning_coach:learning_coach@postgres:5432/learning_coach
DATABASE_BACKUP_MAX_BYTES=268435456

CREDENTIAL_ENCRYPTION_KEY=

OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=
SERPAPI_API_KEY=

RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
